<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!--
        Serveur distant alwaysdata (HTTPS — Let's Encrypt).
        Android 7+ reconnaît Let's Encrypt nativement via le store système.
        Android 6 ne reconnaît pas ISRG Root X1 (ajouté seulement en Android 7.1.1) :
        on l'inclut donc directement dans l'application pour combler ce manque.
    -->
    <domain-config>
        <domain includeSubdomains="true">resultats-bridge.alwaysdata.net</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="@raw/isrg_root_x1"/>
        </trust-anchors>
    </domain-config>

    <!--
        Serveur local embarqué (NanoHTTPD port 8080 — HTTP simple, pas de SSL).
        <domain> ne peut pas exprimer une plage d'IP (ex. 192.168.0.0/16) : ça
        matche un nom d'hôte exact, jamais une IP dynamique reelle du LAN
        (192.168.0.158, 192.168.43.1, ...). La seule solution est d'autoriser
        le HTTP en clair par défaut - seul cas d'usage reel dans l'appli, le
        serveur en ligne utilise toujours https:// explicitement ci-dessus.
    -->
    <base-config cleartextTrafficPermitted="true"/>

</network-security-config>
